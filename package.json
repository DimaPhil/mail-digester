{
  "name": "mail-digester",
  "version": "1.0.0",
  "description": "Private API-fed email reader with topic collections and preference feedback",
  "bin": {
    "mail-digester": "cli/mail-digester.mjs"
  },
  "files": [
    "cli",
    "contracts",
    "skills",
    "docs/ingest.schema.json"
  ],
  "scripts": {
    "dev": "node ./scripts/run-next-with-default-port.mjs dev",
    "build": "next build",
    "start": "node ./scripts/run-next-with-default-port.mjs start",
    "prepare": "node -e \"if(require('fs').existsSync('node_modules/husky')) import('husky').then(({default:husky})=>husky())\"",
    "postinstall": "node -e \"if(process.env.npm_config_global==='true') import('./cli/skill.mjs')\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run api:check && npm run format:check && npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:install": "node scripts/test-cli-install.mjs",
    "verify": "npm run check && npm run test:coverage",
    "verify:full": "npm run verify && npm run build && npm run test:e2e && npm run test:install",
    "analytics:interests": "node analytics/analyze-interests.mjs",
    "analytics:interests:json": "node analytics/analyze-interests.mjs --format json",
    "analytics:llm-context": "node analytics/llm-context.mjs",
    "analytics:llm-context:json": "node analytics/llm-context.mjs --format json",
    "analytics:export": "node analytics/export-interactions.mjs",
    "db:studio": "drizzle-kit studio",
    "api:schema": "node --import tsx scripts/generate-ingest-schema.ts && prettier --write docs/ingest.schema.json",
    "api:contracts": "node --import tsx scripts/generate-api-contract.ts && prettier --write contracts/operations.json",
    "api:check": "node --import tsx scripts/generate-api-contract.ts --check && node scripts/check-api-cli.mjs",
    "db:backup": "node scripts/db-maintenance.mjs backup",
    "db:verify-preserved": "node scripts/db-maintenance.mjs verify",
    "db:migrate-copy": "node --import tsx scripts/migrate-db.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DimaPhil/mail-digester.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DimaPhil/mail-digester/issues"
  },
  "homepage": "https://github.com/DimaPhil/mail-digester#readme",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.1.4",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lucide-react": "^1.8.0",
    "next": "^16.2.3",
    "postcss": "^8.5.6",
    "prettier": "^3.8.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.1.15",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ]
  }
}
