# Load locally through .env.local; Compose loads .env. Never commit filled values.
MAIL_DIGESTER_DB_PATH=./data/mail-digester.sqlite
# Optional one-time migration of existing clients. New keys are managed in Admin.
MAIL_DIGESTER_INGEST_TOKEN=
MAIL_DIGESTER_FEEDBACK_TOKEN=
MAIL_DIGESTER_ALLOWED_SOURCES=tldr,tldr-ai
# Set to the public HTTPS origin when running behind a reverse proxy.
MAIL_DIGESTER_PUBLIC_ORIGIN=
